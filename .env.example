# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Flask session signing key — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Optional: Override the Google Sheets nutrition database URL
# GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv

# Optional: API key required by ESP32 hardware endpoints.
# Set this to any strong secret and match it in the firmware header X-API-Key.
# Leave empty to disable hardware endpoint authentication (local dev only).
# HARDWARE_API_KEY=your-secret-hardware-key

# Optional: Set to "1" to enable Flask debug mode (never use in production)
# FLASK_DEBUG=0
